        <mxCell id="o_QZzeRpQIwtzL6ZNsu4-72" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;车辆打包：（车辆打包贴士）&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-2712" y="-3014" width="468" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_QZzeRpQIwtzL6ZNsu4-73" value="" style="triangle;whiteSpace=wrap;html=1;rotation=90;" parent="1" vertex="1">
          <mxGeometry x="-1940.75" y="-3177.5" width="30" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_QZzeRpQIwtzL6ZNsu4-74" value="" style="triangle;whiteSpace=wrap;html=1;rotation=90;" parent="1" vertex="1">
          <mxGeometry x="-1940.75" y="-3085" width="30" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_QZzeRpQIwtzL6ZNsu4-75" value="&lt;li data-start=&quot;198&quot; data-end=&quot;333&quot;&gt;&lt;strong data-start=&quot;200&quot; data-end=&quot;210&quot;&gt;打架子/木框&lt;/strong&gt;：&lt;br&gt;&lt;ul data-start=&quot;216&quot; data-end=&quot;333&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;216&quot; data-end=&quot;255&quot;&gt;建议使用 &lt;strong data-start=&quot;223&quot; data-end=&quot;236&quot;&gt;专业的木架或金属框&lt;/strong&gt; 固定车辆，减少震动对车体的影响。&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;258&quot; data-end=&quot;302&quot;&gt;关键受力点（车轮、车把、车尾）需要用 &lt;strong data-start=&quot;279&quot; data-end=&quot;289&quot;&gt;海绵/泡沫垫&lt;/strong&gt; 防护，防止摩擦损坏。&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;305&quot; data-end=&quot;333&quot;&gt;固定时要确保车轮不能左右摆动，避免运输途中倾斜。&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;334&quot; data-end=&quot;429&quot;&gt;&lt;strong data-start=&quot;336&quot; data-end=&quot;344&quot;&gt;防护材料&lt;/strong&gt;：&lt;br&gt;&lt;ul data-start=&quot;350&quot; data-end=&quot;429&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;350&quot; data-end=&quot;393&quot;&gt;使用 &lt;strong data-start=&quot;355&quot; data-end=&quot;366&quot;&gt;防刮膜、气泡膜&lt;/strong&gt; 包裹车身，特别是油箱、侧壳、排气管等易刮花部位。&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;396&quot; data-end=&quot;429&quot;&gt;轮胎底部建议垫 &lt;strong data-start=&quot;406&quot; data-end=&quot;416&quot;&gt;橡胶垫/木板&lt;/strong&gt;，防止颠簸导致的损坏。&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;430&quot; data-end=&quot;527&quot;&gt;&lt;strong data-start=&quot;432&quot; data-end=&quot;440&quot;&gt;固定方式&lt;/strong&gt;：&lt;br&gt;&lt;ul data-start=&quot;446&quot; data-end=&quot;527&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;446&quot; data-end=&quot;492&quot;&gt;绑带固定时，&lt;strong data-start=&quot;454&quot; data-end=&quot;469&quot;&gt;避免绑在车壳或排气管上&lt;/strong&gt;，建议固定在车架、前叉、后摇臂等结实部位。&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;495&quot; data-end=&quot;527&quot;&gt;确保绑带受力均匀，不宜太紧或太松，防止拉坏车身或运输中松脱。&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-1554" y="-2952.5" width="530" height="430" as="geometry" />
        </mxCell>
        <mxCell id="o_QZzeRpQIwtzL6ZNsu4-76" value="" style="triangle;whiteSpace=wrap;html=1;rotation=90;" parent="1" vertex="1">
